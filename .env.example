# =====================================
# GAIA CONSCIOUS - ENVIRONMENT SETTINGS
# =====================================

# DATABASE SETTINGS
# Name of the Gaia PostgreSQL database
POSTGRES_DB=gaia_conscious

# Database administrator username
POSTGRES_USER=gc_owner

# Local development password (change in your private .env file)
POSTGRES_PASSWORD=change_me_locally

# Flask database connection
DATABASE_URL=postgresql+psycopg://gc_owner:change_me_locally@localhost:5432/gaia_conscious


# FLASK SETTINGS
# Secret key used to protect sessions (never use this example in production)
SECRET_KEY=replace_with_a_secure_random_secret

# Application environment
FLASK_ENV=development


# MINIO STORAGE SETTINGS
# Local file storage username
MINIO_ROOT_USER=gaiaadmin

# Local file storage password
MINIO_ROOT_PASSWORD=change_me_locally

# MinIO server address
MINIO_ENDPOINT=http://localhost:9000

# Bucket where Gaia files will be stored
MINIO_BUCKET=gaia-documents


# CLAMAV SETTINGS
# Host running the ClamAV antivirus service
CLAMAV_HOST=localhost

# ClamAV connection port
CLAMAV_PORT=3310


# MAILPIT SETTINGS
# Local email testing server
MAIL_SERVER=localhost

# Mailpit SMTP port
MAIL_PORT=1025

# Mailpit web interface port
MAILPIT_WEB_PORT=8025